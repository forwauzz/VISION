# Vision — copy to .env and fill values. Do not commit .env.
# VITE_API_BASE_URL=  (optional; leave empty when using Netlify Functions so /api uses same origin)
# Whisper + Vision (frame descriptions). Local: npm run server. Netlify: set OPENAI_API_KEY in site env.
# OPENAI_API_KEY=your_openai_key
# TRANSCRIPTION_PORT=3009
# Optional: Persist session recordings in IndexedDB for access/re-run per case (default off)
# VITE_STORE_RECORDINGS=false