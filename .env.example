# Vision — copy to .env and fill values. Do not commit .env.
# VITE_API_BASE_URL=
# Optional: Whisper transcription + Vision (frame descriptions). Run: npm run server
# OPENAI_API_KEY=your_openai_key
# TRANSCRIPTION_PORT=3009
# Optional: Persist session recordings in IndexedDB for access/re-run per case (default off)
# VITE_STORE_RECORDINGS=false